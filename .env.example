# Copy to .env and adjust. Every setting is optional except PRINTER_URI.
# .env may hold NOTIFY_TOKEN: keep it private (chmod 600 .env) and never commit it.

# Printer address. For most printers: ipp://<printer-ip>/ipp/print
# Give the printer a fixed IP (DHCP reservation in your router) so this never changes.
PRINTER_URI=ipp://192.168.1.50/ipp/print

# When to print (cron syntax: minute hour day-of-month month day-of-week), at least 3 hours apart.
# Default: Mondays and Thursdays at 09:00. `dont-dry next` lists the upcoming times.
SCHEDULE=0 9 * * 1,4
TZ=America/Sao_Paulo

# Print once as soon as the scheduler starts (handy for the first test). Never again within an
# hour of a page that reached the printer, so restarts do not print twice.
RUN_ON_START=false

# Language of the printed page, the notifications and the command output: en-US or pt-BR.
LOCALE=en-US

# a4 or letter
PAGE_SIZE=a4
# Heading printed on the page (default: "dont-dry maintenance page", in the LOCALE's language)
# PAGE_TITLE=Office printer

# auto picks the best format the printer accepts: PDF, then PWG raster, then JPEG.
DOCUMENT_FORMAT=auto

# Print your own file instead of the built-in test page (PDF, PNG or JPEG).
# With Docker, mount it into the container, e.g. ./page.png:/page.png:ro
# CUSTOM_PAGE=/page.png

# Retries when the printer can't be reached (asleep, Wi-Fi hiccup). A job the printer accepted
# is never sent again.
RETRIES=3
RETRY_DELAY=300
# Seconds to wait for a job to finish before reporting it as not done.
JOB_TIMEOUT=300

# Warn when any ink level is at or below this percentage (if the printer reports it).
LOW_INK_THRESHOLD=10

# Notifications: plain-text POST, works with ntfy.sh (https://ntfy.sh/your-topic),
# a self-hosted ntfy, or any webhook that accepts a text body.
# NOTIFY_URL=https://ntfy.sh/my-printer-topic
# NOTIFY_TOKEN=
# failure (default, also low ink) | always | never
NOTIFY_ON=failure

# For ipps:// only: check the printer's certificate (most printers use a self-signed one).
TLS_VERIFY=false

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
